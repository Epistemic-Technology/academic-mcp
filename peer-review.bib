  journal = {Engineering Science and Education Journal},
  year = {2002},
  abstract = {L, t has served science well, a widely held view-being that while it may not be pertect it is nonetheless far better than anything else we have been able to devise. And yet, paradoxically, it may be a'dead hand '-a suggestion sonietimes captured in the phrase 'the ...}
